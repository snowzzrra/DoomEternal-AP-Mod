/* @ink@ = #080b0d */
/* @panel@ = #111619 */
/* @panel2@ = #171e22 */
/* @line@ = #3b4549 */
/* @text@ = #f1f3ef */
/* @muted@ = #9ba3a3 */
/* @accent@ = #a8d52a */
/* @ap@ = #43bfc7 */
/* @warn@ = #f2c230 */
/* @bad@ = #ff8080 */
QWidget { background:transparent; color:@text@; font-family:'Segoe UI','Noto Sans','Aptos',sans-serif; font-size:10.5pt; }
QLabel { background:transparent; }
QFrame#topbar,QFrame#card { background:transparent; border:0; }
QLabel#brandTop { font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:9pt; font-weight:700; letter-spacing:2px; color:@accent@; }
QLabel#brand { font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:16pt; font-weight:700; }
QLabel#title { font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:18pt; font-weight:700; }
QLabel#eyebrow,QLabel#section { font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:9pt; font-weight:700; letter-spacing:1px; color:@accent@; }
QLabel#fieldLabel { font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:9pt; font-weight:700; letter-spacing:1px; color:@muted@; }
QWidget#roomSection,QWidget#roomFields,QWidget#roomIdentity,QWidget#gamePaths,QWidget#gameSummary { background:transparent; }
QLabel#muted,QLabel#stateDetail { color:@muted@; font-size:9pt; }
QFrame#actionStrip QLabel#muted { color:@text@; font-size:10.5pt; }
QLabel#empty { color:@muted@; font-size:10.5pt; }
QLabel#state { color:@accent@; }
QLabel#warning { color:@warn@; }
QLabel[tone="accent"] { color:@accent@; }
QLabel[tone="ap"] { color:@ap@; }
QLabel[tone="warn"] { color:@warn@; }
QLabel[tone="muted"] { color:@muted@; }
QLineEdit,QSpinBox,QComboBox { background:#0c1113; color:@text@; border:1px solid @line@; padding:0px 8px; min-height:34px; max-height:34px; selection-background-color:@accent@; }
QLineEdit:disabled,QSpinBox:disabled,QComboBox:disabled { background:@panel2@; color:@muted@; }
QComboBox QAbstractItemView { background:@panel@; color:@text@; selection-background-color:@panel2@; }
QLineEdit:focus,QSpinBox:focus,QComboBox:focus,QPushButton:focus { border:2px solid @accent@; outline:0; min-height:32px; max-height:32px; }
QPushButton,QToolButton { background:transparent; border:1px solid @line@; color:@text@; padding:0px 16px; min-height:34px; max-height:34px; font-family:'Bahnschrift SemiCondensed','Segoe UI'; font-size:10.5pt; font-weight:700; border-radius:0px; }
QPushButton:hover,QToolButton:hover { border-color:@accent@; }
QPushButton#primary { background:transparent; color:#0b1206; }
QPushButton[doomButton="true"] { border:0; min-height:36px; max-height:36px; }
QPushButton#link { border:0; color:@accent@; min-height:32px; max-height:32px; }
QPushButton#link:hover { text-decoration:underline; }
QPushButton#danger { background:transparent; color:@bad@; border-color:@bad@; }
QPushButton:disabled,QToolButton:disabled { color:@muted@; background:transparent; }
QPushButton#nav { border:0; padding:0px 16px; min-height:56px; max-height:56px; color:@muted@; }
QPushButton#nav:hover { color:@text@; }
QToolButton#language { border:0; background:transparent; }
QToolButton#language:hover,QPushButton#nav:hover { background:@panel2@; }
QPushButton#nav:checked { color:@text@; }
QLabel#milestone { color:@muted@; }
QLabel#milestone[complete="true"] { color:@accent@; }
QLabel#milestone[current="true"] { color:@text@; }
QFrame#stepLine,QFrame#separator { background:@line@; max-height:1px; min-height:1px; border:0; }
QTabWidget::pane { border:0; }
QTabBar::tab { background:transparent; color:@muted@; padding:8px 16px; border-bottom:2px solid transparent; }
QTabBar::tab:selected { color:@text@; border-bottom-color:@accent@; }
QPlainTextEdit,QTableWidget,QListWidget { background:transparent; color:@text@; border:0; }
QTableWidget::item,QListWidget::item { border-bottom:1px solid @line@; }
QTableWidget::item:hover,QListWidget::item:hover { background:@panel2@; }
QHeaderView::section { background:@panel@; color:@muted@; border:0; padding:8px; }
QCheckBox { spacing:8px; }
QCheckBox::indicator { width:12px; height:12px; border:1px solid @line@; background:#0c1113; }
QCheckBox::indicator:checked { background:@accent@; border-color:@accent@; }
QCheckBox#switch::indicator,QCheckBox#switch::indicator:checked { width:36px; height:18px; border:0; background:transparent; }
QWidget#stepper QSpinBox { border-left:0; border-right:0; padding:0; }
QWidget#stepper QPushButton { padding:0; }
QWidget#stepper QPushButton#stepDown { border-right:1px solid @line@; }
QWidget#stepper QPushButton#stepUp { border-left:1px solid @line@; }
QLabel#ammoRefillTitle { color:@muted@; font-size:10.5pt; }
QLabel#ammoRefillKey { border:1px solid @line@; color:@muted@; }
QPlainTextEdit#technicalDetails { background:@panel@; padding:12px; font-family:'Consolas',monospace; font-size:9pt; }
QWidget#optionRow,QWidget#itemRow { background:transparent; border:0; }
QWidget#optionBody,QWidget#optionDescription,QFrame#optionRow QCheckBox { background:transparent; }
QPushButton[compact="true"] { padding-left:0; padding-right:0; }
QPushButton#link[gameChange="true"] { min-height:18px; max-height:18px; }
QCheckBox#requirementOption[goalLocked="true"],QCheckBox:disabled { color:@muted@; }
QPushButton[conflict="true"] { border:1px solid @warn@; }
QPushButton[conflict="true"]:focus { border:2px solid @warn@; }
QPushButton#optionCategory { color:@accent@; font-size:9pt; letter-spacing:1px; border:0; padding:0; text-align:left; }
QScrollBar:vertical { width:8px; margin:0; background:transparent; border:0; }
QScrollBar:horizontal { height:8px; margin:0; background:transparent; border:0; }
QScrollBar::handle { background:@line@; border:0; border-radius:0; }
QScrollBar::handle:hover { background:@muted@; }
QScrollBar::handle:vertical { min-height:24px; }
QScrollBar::handle:horizontal { min-width:24px; }
QScrollBar::add-line,QScrollBar::sub-line { width:0; height:0; border:0; background:transparent; }
QScrollBar::add-page,QScrollBar::sub-page,QAbstractScrollArea::corner { background:transparent; border:0; }

QLabel#conflictWarning { color:@warn@; font-size:9pt; }
QLabel#itemStatus { font-size:9pt; }

QPushButton#symptom { border:0; color:@text@; min-height:32px; max-height:32px; padding:0; text-align:left; }
QPushButton#symptom:hover { color:@accent@; }

QDialog,QMenu { background:@ink@; }
QToolTip { background:@panel2@; color:@text@; border:1px solid @line@; padding:4px; }
QPushButton#helpIcon { padding:0; border:0; min-height:14px; max-height:14px; color:@muted@; font-size:9pt; }
QPushButton#helpIcon:hover { color:@accent@; }
QWidget#stepper QPushButton,QWidget#compactStepper QPushButton { border:1px solid @line@; padding:0; }
QWidget#stepper QPushButton { min-height:34px; max-height:34px; }
QWidget#compactStepper QSpinBox { min-height:26px; max-height:26px; border-left:0; border-right:0; padding:0; font-size:9pt; }
QWidget#compactStepper QPushButton { min-height:26px; max-height:26px; font-size:9pt; }
